#!/usr/bin/env bash
# AppImage entry: the hub UI. Shared by the launcher's AppImage
# (packaging/linux/build-appimage.sh) and title apps (packaging/title/), whose
# hub finds its title in usr/bin/title/ and runs as that title's app.
# Launcher: the CLI is `<AppImage> cli ...`; the title catalog is maintained
# under ~/.local/share/retcomm/catalog (fetched on use). Set RETCOMM_HOME=/some/dir
# (or drop a retcomm-root.json beside the AppImage) to keep config+data there.
# Title app: its state is <dir of the AppImage>/<id>-data/, never in the mount.
set -euo pipefail
HERE="$(dirname "$(readlink -f "$0")")"
# Hub font lookup and other relocatable paths use APPDIR. The type-2 runtime
# normally sets this; export it ourselves so extracted AppDir / AppRun launches
# and odd launchers still resolve usr/share/retcomm/fonts and usr/bin/fonts.
export APPDIR="${APPDIR:-${HERE}}"
export PATH="${HERE}/usr/bin:${PATH}"
# Prefer bundled libs when present.
if [[ -d "${HERE}/usr/lib" ]]; then
  export LD_LIBRARY_PATH="${HERE}/usr/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi
if [[ "${1:-}" == "cli" && -x "${HERE}/usr/bin/retcomm" ]]; then
  shift
  exec "${HERE}/usr/bin/retcomm" "$@"
fi
exec "${HERE}/usr/bin/retro-hub" "$@"
