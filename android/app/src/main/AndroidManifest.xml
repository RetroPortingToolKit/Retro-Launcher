<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Libraries (ROMs, BIOS, saves) are read with ordinary file calls from folders
         the player picks on shared storage (LauncherActivity.pickFolder). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Self-update: the release APK goes to the package installer (installApk). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Back stays a key event (predictive back, the targetSdk 36 default, would
         bypass SDL and close the app); the hub reads it as Escape. -->
    <application android:label="${appLabel}" android:allowBackup="false"
        android:enableOnBackInvokedCallback="false"
        android:extractNativeLibs="true" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".LauncherActivity" android:exported="true"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|navigation|density"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".InstallStatusReceiver" android:exported="false" />
    </application>
</manifest>
